---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CertificateExplorer from '../components/CertificateExplorer.astro';

const certificates = (await getCollection('certificates')).sort((a, b) => {
  const aDate = a.data.sortDate?.valueOf() ?? Number.NEGATIVE_INFINITY;
  const bDate = b.data.sortDate?.valueOf() ?? Number.NEGATIVE_INFINITY;
  return bDate - aDate || a.data.title.localeCompare(b.data.title);
});
const projects = (await getCollection('projects')).map((project) => ({
  id: project.id,
  title: project.data.title,
}));
---

<BaseLayout title="Certificates — Francesco Castiglione" description="Certificates and credentials connected to Francesco Castiglione's projects and professional development.">
  <header class="page-intro">
    <div class="shell">
      <span class="eyebrow">Certificates & credentials</span>
      <div class="page-intro__grid">
        <h1 class="page-title">The documentation behind the experience.</h1>
        <p class="page-intro__copy">This archive connects each credential to the projects, programs, places, and skills it supports. Open any certificate at full resolution or download its original file.</p>
      </div>
    </div>
  </header>

  <section class="certificates-index">
    <div class="shell"><CertificateExplorer certificates={certificates} projects={projects} /></div>
  </section>
</BaseLayout>

<style>
  .certificates-index { padding: 0 0 clamp(6rem, 12vw, 10rem); }
</style>
