---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectMap from '../components/ProjectMap.astro';
import Wordmark from '../components/Wordmark.astro';

const projects = (await getCollection('projects')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
const featuredProjects = projects.filter((project) => project.data.featured).slice(0, 2);
const news = (await getCollection('news', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const latestNews = news[0];
---

<BaseLayout>
  <section class="personal-hero">
    <div class="shell personal-hero__grid">
      <div class="personal-hero__portrait">
        <img src="/assets/francesco-castiglione.jpg" alt="Francesco Castiglione at the European Parliament" />
        <div class="personal-hero__location" aria-label="Born in Catania. Based between Trieste and Ljubljana. Working across Europe.">
          <span>Born in <strong>Catania</strong></span>
          <span class="personal-hero__separator" aria-hidden="true">·</span>
          <span>Based between <strong>Trieste and Ljubljana</strong></span>
          <span class="personal-hero__separator" aria-hidden="true">·</span>
          <span>Working <strong>across Europe</strong></span>
        </div>
      </div>
      <div class="personal-hero__copy">
        <span class="eyebrow">About me</span>
        <h1 class="personal-hero__name"><Wordmark hero /></h1>
        <p class="personal-hero__statement">Projects, places, and people — connected by experience.</p>
        <p class="lede">My experience moves between European project development, grant processes, international mobility, youth participation, facilitation, and coordination. The common thread is helping people organise around an idea and move it forward.</p>
        <div class="personal-hero__actions">
          <a class="button" href="/about/">More about me</a>
          <a class="text-link" href="/cv/">View CV</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--surface map-preview">
    <div class="shell">
      <div class="map-preview__intro">
        <span class="eyebrow">Projects by place</span>
        <h2>Building projects, partnerships, and connections. <span>Bringing ideas to life across Europe.</span></h2>
        <div class="map-preview__context">
          <div>
            <h3>A geographical record of collaboration.</h3>
            <p>This is a record of the projects I’ve contributed to, the places they’ve taken me, and what I’ve learned along the way.</p>
          </div>
          <div class="map-preview__actions">
            <a class="button" href="/projects/">Explore projects</a>
            <a class="button button--outline" href="/contact/">Start a conversation</a>
          </div>
        </div>
      </div>
      <ProjectMap projects={projects} compact />
    </div>
  </section>

  <section class="section projects-preview">
    <div class="shell">
      <div class="section-heading">
        <span class="eyebrow">Selected projects</span>
        <h2 class="section-title">A closer look at the projects.</h2>
        <p>Explore each project by place, program, role, activity, and the skills developed along the way.</p>
      </div>
      <div class="projects-preview__grid">
        {featuredProjects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
      <a class="text-link projects-preview__link" href="/projects/">View the complete project archive <span>↗</span></a>
    </div>
  </section>

  <section class="section section--soft-blue capabilities">
    <div class="shell">
      <div class="section-heading">
        <span class="eyebrow">How I contribute</span>
        <h2 class="section-title">From first idea to accountable delivery.</h2>
        <p>Work that connects planning, people, documentation, communication, and follow-through.</p>
      </div>
      <div class="capabilities__grid">
        <article><span>01</span><h3>Project development</h3><p>Research, opportunity scouting, proposal support, planning, and application processes.</p></article>
        <article><span>02</span><h3>Partnerships</h3><p>Clear communication across international teams, institutions, organisations, and stakeholders.</p></article>
        <article><span>03</span><h3>Monitoring & reporting</h3><p>Structured administrative support, grant-management systems, monitoring, and reporting workflows.</p></article>
        <article><span>04</span><h3>Mobility & facilitation</h3><p>International logistics, participant support, non-formal education, and group leadership.</p></article>
      </div>
    </div>
  </section>

  {latestNews && (
    <section class="section--tight latest-note">
      <div class="shell latest-note__inner">
        <span class="eyebrow">Latest update · {latestNews.data.publishedAt.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}</span>
        <h2>{latestNews.data.title}</h2>
        <p>{latestNews.data.summary}</p>
        <a class="text-link" href={`/news/${latestNews.id}/`}>Read the note</a>
      </div>
    </section>
  )}

  <section class="section contact-cta">
    <div class="shell contact-cta__inner">
      <span class="eyebrow">Open to the right next project</span>
      <h2 class="section-title">Have an idea worth building together?</h2>
      <a class="button" href="/contact/">Start a conversation</a>
    </div>
  </section>
</BaseLayout>

<style>
  .personal-hero { padding: clamp(3.5rem, 8vw, 7.5rem) 0; }
  .personal-hero__grid {
    display: grid;
    grid-template-columns: minmax(19rem, .8fr) 1.2fr;
    gap: clamp(3rem, 9vw, 8rem);
    align-items: center;
  }
  .personal-hero__portrait { position: relative; }
  .personal-hero__portrait::before {
    content: '';
    position: absolute;
    inset: 1rem -1rem -1rem 1rem;
    z-index: -1;
    border-radius: var(--radius-xl);
    background: var(--surface-strong);
  }
  .personal-hero__portrait img {
    width: 100%;
    aspect-ratio: .92;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: var(--radius-xl);
  }
  .personal-hero__location {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .25rem .55rem;
    margin-top: 1.15rem;
    color: var(--muted);
    font-size: clamp(.74rem, .9vw, .82rem);
    line-height: 1.5;
    letter-spacing: .005em;
  }
  .personal-hero__location strong { color: var(--ink); font-weight: 620; }
  .personal-hero__separator { color: var(--accent); font-weight: 700; }
  .personal-hero__name { margin: 1rem 0 1.5rem; font: inherit; }
  .personal-hero__statement {
    max-width: 38rem;
    margin: 0 0 1rem;
    font-size: clamp(1.45rem, 2.7vw, 2.25rem);
    font-weight: 560;
    line-height: 1.12;
    letter-spacing: -.045em;
  }
  .personal-hero__copy .lede { max-width: 42rem; margin: 0; }
  .personal-hero__actions { display: flex; align-items: center; gap: 1.5rem; margin-top: 2rem; }

  .map-preview__intro { margin-bottom: clamp(2.8rem, 6vw, 5rem); }
  .map-preview__intro > h2 {
    max-width: 68rem;
    margin: 1rem 0 clamp(2.8rem, 6vw, 5rem);
    font-size: clamp(2.6rem, 6vw, 5.4rem);
    font-weight: 610;
    line-height: .98;
    letter-spacing: -.065em;
  }
  .map-preview__intro > h2 span { color: var(--accent); }
  .map-preview__context {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 3rem;
    align-items: end;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }
  .map-preview__context h3 {
    margin: 0 0 .7rem;
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    font-weight: 610;
    line-height: 1.05;
    letter-spacing: -.045em;
  }
  .map-preview__context p { max-width: 43rem; margin: 0; color: var(--muted); }
  .map-preview__actions { display: flex; flex-wrap: wrap; gap: .7rem; justify-content: flex-end; }

  .projects-preview__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .projects-preview__link { margin-top: 2rem; }

  .section--soft-blue .eyebrow, .section--soft-blue .section-heading p { color: var(--muted); }
  .capabilities__grid { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid rgba(51,73,104,.16); }
  .capabilities article { min-height: 18rem; padding: 1.4rem 1.4rem 1.4rem 0; border-right: 1px solid rgba(51,73,104,.16); }
  .capabilities article + article { padding-left: 1.4rem; }
  .capabilities article:last-child { border-right: 0; }
  .capabilities article > span { color: var(--accent); font-size: .68rem; }
  .capabilities h3 { margin: 7rem 0 .7rem; font-size: 1.15rem; letter-spacing: -.025em; }
  .capabilities article p { margin: 0; color: var(--muted); font-size: .8rem; }

  .latest-note { border-bottom: 1px solid var(--line); }
  .latest-note__inner { display: grid; grid-template-columns: 1fr 1fr 1.2fr auto; gap: 2rem; align-items: center; }
  .latest-note h2 { margin: 0; font-size: 1.35rem; letter-spacing: -.035em; }
  .latest-note p { margin: 0; color: var(--muted); font-size: .82rem; }

  .contact-cta__inner { display: grid; grid-template-columns: 1fr auto; gap: 3rem; align-items: end; }
  .contact-cta__inner .eyebrow { grid-column: 1 / -1; margin-bottom: -1.5rem; }
  .contact-cta .section-title { max-width: 52rem; }

  @media (max-width: 900px) {
    .personal-hero__grid, .map-preview__context { grid-template-columns: 1fr; }
    .map-preview__actions { justify-content: flex-start; }
    .personal-hero__portrait { width: min(29rem, 92%); }
    .capabilities__grid { grid-template-columns: repeat(2, 1fr); }
    .capabilities article:nth-child(2) { border-right: 0; }
    .capabilities article:nth-child(n+3) { border-top: 1px solid rgba(51,73,104,.16); }
    .latest-note__inner { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 650px) {
    .personal-hero { padding-top: 1.5rem; }
    .personal-hero__grid { gap: 2.8rem; }
    .personal-hero__portrait { width: calc(100% - .8rem); }
    .personal-hero__location { gap: .2rem .45rem; }
    .projects-preview__grid, .capabilities__grid { grid-template-columns: 1fr; }
    .capabilities article { border-right: 0; border-top: 1px solid rgba(51,73,104,.16); padding-left: 0 !important; }
    .capabilities h3 { margin-top: 4rem; }
    .latest-note__inner, .contact-cta__inner { grid-template-columns: 1fr; }
    .contact-cta__inner .eyebrow { margin-bottom: 0; }
  }
</style>
