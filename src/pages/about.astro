---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AffiliationsSection from '../components/AffiliationsSection.astro';

const affiliations = (await getCollection('affiliations')).sort((a, b) => a.data.sortOrder - b.data.sortOrder);
const projects = await getCollection('projects');
const news = await getCollection('news');
---

<BaseLayout title="About — Francesco Castiglione" description="Francesco Castiglione works on EU-funded projects and studies Business Administration and Management, with experience in youth participation and European cooperation.">
  <section class="about-story">
    <h1 class="sr-only">About Francesco Castiglione</h1>
    <div class="shell">
      <div class="about-story__grid">
        <figure>
          <img src="/assets/gallery/eu-youth-stakeholders-group-brussels-2025.jpg" alt="Francesco Castiglione speaking during the first EU Youth Stakeholders Group meeting in Brussels" />
        </figure>
        <div class="prose about-story__intro">
          <span class="eyebrow">About me</span>
          <p class="lede">I work as an assistant to a highly experienced Project Manager on EU-funded projects, gaining hands-on experience in proposal development, project coordination and implementation, and partner relations. I also have the opportunity to work alongside some of the most talented people in Europe, learning from their expertise, perspectives, and experience.</p>
          <div class="about-story__actions">
            <a class="button" href="/cv/">View the full CV</a>
            <a class="text-link" href="/projects/">Explore the projects</a>
          </div>
        </div>
      </div>

      <div class="about-story__details">
        <article>
          <span class="eyebrow">Studies</span>
          <p>Alongside my professional work, I study Business Administration and Management at the University of Trieste. Between 2026 and 2027, I am an Erasmus+ student at the University of Ljubljana – School of Economics and Business (SEB). My studies are giving me a stronger understanding of how organisations operate, how decisions are made, and how economic, managerial, and strategic thinking can be applied in practice. Studying abroad also exposes me to different academic perspectives and ways of approaching problems. Combined with my practical experience, this is helping me build strong foundations in management, analytical thinking, and professional judgement.</p>
        </article>
        <article>
          <span class="eyebrow">European engagement</span>
          <p>I also co-founded One Hour for Europe Italia, where I am an Advisor and Project Manager and work on projects and events focused on youth participation, active citizenship, international cooperation, and European mobility.</p>
          <p>Among other activities, I am a member of the EU Youth Stakeholders Group, which brings together youth organisations and stakeholders to contribute to EU youth policy, consultations, and initiatives. I also served as an Ambassador for the European Year of Youth 2022 in Italy, promoting European opportunities, active citizenship, and youth participation.</p>
          <p>Through this work, I also act as an interest representative registered in the <a href="https://transparency-register.europa.eu/index_en" target="_blank" rel="noreferrer">EU Transparency Register</a>. I use this role to represent young people's interests in dialogue with European institutions, particularly by supporting and defending youth mobility programmes such as Erasmus+, the European Solidarity Corps, and DiscoverEU.</p>
        </article>
      </div>
    </div>
  </section>

  <AffiliationsSection affiliations={affiliations} projects={projects} news={news} />
</BaseLayout>

<style>
  .about-story { padding: clamp(2.2rem, 5vw, 4rem) 0 clamp(3.5rem, 7vw, 6rem); }
  .about-story__grid { display: grid; grid-template-columns: minmax(20rem, .95fr) 1.05fr; gap: clamp(2.5rem, 7vw, 6rem); align-items: center; }
  .about-story figure { margin: 0; }
  .about-story figure img { width: 100%; aspect-ratio: 16 / 11; object-fit: cover; object-position: 50% 45%; border-radius: var(--radius-xl); }
  .about-story__intro .eyebrow { display: block; margin-bottom: 1rem; }
  .about-story__intro .lede { max-width: 43rem; margin: 0; color: var(--ink); text-align: justify; text-justify: inter-word; hyphens: auto; }
  .about-story__actions { display: flex; align-items: center; gap: 1.5rem; margin-top: 2rem; }
  .about-story__details { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: clamp(3.5rem, 7vw, 5.5rem); }
  .about-story__details article { position: relative; overflow: hidden; padding: clamp(1.3rem, 3vw, 2rem) clamp(1.3rem, 3vw, 2rem) clamp(1.3rem, 3vw, 2rem) clamp(1.55rem, 3.4vw, 2.3rem); border: 1px solid var(--line); border-radius: .75rem; background: linear-gradient(145deg, var(--white), var(--blue-mist)); }
  .about-story__details article::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 3px; background: var(--accent); }
  .about-story__details .eyebrow { display: block; margin-bottom: 1rem; color: var(--accent-dark); font-size: .55rem; font-weight: 800; letter-spacing: .1em; }
  .about-story__details p { margin: 0; color: var(--ink); font-size: clamp(.82rem, 1.2vw, .94rem); line-height: 1.72; text-align: justify; text-justify: inter-word; hyphens: auto; }
  .about-story__details p + p { margin-top: 1rem; }
  @media (max-width: 900px) { .about-story__grid, .about-story__details { grid-template-columns: 1fr; } .about-story figure { width: min(42rem, 100%); } }
  @media (max-width: 760px) { .about-story { padding-top: 1.5rem; } .about-story__actions { align-items: flex-start; flex-direction: column; gap: 1rem; } }
</style>
