---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experience, education, languages } from '../data/cv';
---

<BaseLayout title="CV — Francesco Castiglione" description="Professional experience, education, and languages of Francesco Castiglione.">
  <header class="page-intro cv-intro">
    <div class="shell">
      <span class="eyebrow">Curriculum vitae</span>
      <div class="page-intro__grid">
        <h1 class="page-title">Experience built across disciplines and borders.</h1>
        <div>
          <p class="page-intro__copy">A privacy-conscious web version of my professional record, focused on the experience, education, and skills most relevant to my work.</p>
          <div class="cv-intro__actions">
            <a class="button" href="/contact/">Contact me</a>
            <a class="text-link" href="https://www.linkedin.com/in/francescocastiglione5/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <section class="cv-section">
    <div class="shell cv-layout">
      <aside><span class="eyebrow">Experience</span><p>Professional work, European initiatives, mobility, facilitation, and aviation training.</p></aside>
      <div class="timeline">
        {experience.map((item) => (
          <article class="timeline__item">
            <span>{item.period}</span>
            <div>
              <h2>{item.role}</h2>
              <h3>{item.organisation}</h3>
              <p>{item.summary}</p>
              {item.highlights.length > 0 && <ul>{item.highlights.map((highlight) => <li>{highlight}</li>)}</ul>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cv-section section--surface">
    <div class="shell cv-layout">
      <aside><span class="eyebrow">Education</span><p>Formal training and professional development.</p></aside>
      <div class="education-list">
        {education.map((item) => (
          <article><span>{item.period}</span><div><h2>{item.title}</h2><p>{item.institution}</p></div></article>
        ))}
      </div>
    </div>
  </section>

  <section class="cv-section">
    <div class="shell cv-layout">
      <aside><span class="eyebrow">Languages</span><p>Working across international teams and settings.</p></aside>
      <div class="language-list">
        {languages.map((item) => <article><h2>{item.language}</h2><span>{item.level}</span></article>)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cv-intro__actions { display: flex; align-items: center; gap: 1.5rem; margin-top: 1.8rem; }
  .cv-section { padding: clamp(4rem, 8vw, 7rem) 0; border-top: 1px solid var(--line); }
  .cv-layout { display: grid; grid-template-columns: minmax(12rem, 20rem) 1fr; gap: clamp(3rem, 8vw, 7rem); }
  .cv-layout aside p { max-width: 15rem; margin: .8rem 0 0; color: var(--muted); font-size: .78rem; }
  .timeline { border-top: 1px solid var(--line); }
  .timeline__item { display: grid; grid-template-columns: 9rem 1fr; gap: 2rem; padding: 2rem 0; border-bottom: 1px solid var(--line); }
  .timeline__item > span, .education-list article > span { color: var(--muted); font-size: .72rem; font-variant-numeric: tabular-nums; }
  .timeline h2, .education-list h2, .language-list h2 { margin: 0; font-size: 1.25rem; line-height: 1.2; letter-spacing: -.035em; }
  .timeline h3 { margin: .38rem 0 .85rem; color: var(--muted); font-size: .78rem; font-weight: 550; }
  .timeline p { max-width: 45rem; margin: 0; color: var(--muted); font-size: .86rem; }
  .timeline ul { margin: .85rem 0 0; padding-left: 1.1rem; color: var(--muted); font-size: .78rem; }
  .education-list { border-top: 1px solid var(--line); }
  .education-list article { display: grid; grid-template-columns: 9rem 1fr; gap: 2rem; padding: 1.7rem 0; border-bottom: 1px solid var(--line); }
  .education-list p { margin: .35rem 0 0; color: var(--muted); font-size: .78rem; }
  .language-list { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--line); }
  .language-list article { display: flex; justify-content: space-between; gap: 2rem; padding: 1.7rem 1.7rem 1.7rem 0; border-bottom: 1px solid var(--line); }
  .language-list article:nth-child(odd) { border-right: 1px solid var(--line); }
  .language-list article:nth-child(even) { padding-left: 1.7rem; }
  .language-list span { color: var(--accent); font-size: .75rem; font-weight: 650; }
  @media (max-width: 760px) { .cv-layout { grid-template-columns: 1fr; } .timeline__item, .education-list article { grid-template-columns: 1fr; gap: .7rem; } .language-list { grid-template-columns: 1fr; } .language-list article { padding-left: 0 !important; border-right: 0 !important; } }
</style>
