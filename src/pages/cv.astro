---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experience, education, languages } from '../data/cv';
---

<BaseLayout title="CV — Francesco Castiglione" description="EU project-management experience, education, and languages of Francesco Castiglione.">
  <header class="cv-hero">
    <h1 class="sr-only">Curriculum vitae</h1>
    <div class="shell cv-hero__grid">
      <div class="cv-hero__portrait">
        <img src="/assets/francesco-castiglione.jpg" alt="Portrait of Francesco Castiglione at the European Parliament" />
      </div>
      <div class="cv-hero__summary">
        <p>I work as an Assistant Project Manager on EU-funded research and innovation projects and as a Co-Founder, Advisor, and Project Manager at One Hour for Europe. Alongside this, I study Business Administration and Management, building on experience in youth participation, European mobility, facilitation, and aviation.</p>
        <div class="cv-hero__actions">
          <a class="button button--small" href="/contact/">Contact options</a>
          <a class="text-link" href="https://www.linkedin.com/in/francescocastiglione5/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
        </div>
      </div>
    </div>
  </header>

  <section class="cv-snapshot">
    <div class="shell cv-snapshot__grid">
      <article><span>Professional focus</span><strong>EU Project Management</strong><p>Proposal development, coordination, implementation, and partner relations</p></article>
      <article><span>Current studies</span><strong>Business Administration</strong><p>University of Trieste · Erasmus+ at Ljubljana SEB</p></article>
      <article><span>European engagement</span><strong>Youth policy & participation</strong><p>EU Youth Stakeholders Group · One Hour for Europe</p></article>
    </div>
  </section>

  <main class="cv-main">
    <section class="cv-block">
      <div class="shell">
        <div class="cv-block__heading">
          <div><span class="eyebrow">Experience</span><h2>Current roles and previous experience.</h2></div>
          <p>Ongoing responsibilities and completed roles across European projects, youth policy, international mobility, facilitation, and aviation.</p>
        </div>
        <div class="experience-grid">
          {experience.map((item) => (
            <article class:list={["experience-card", { "experience-card--current": item.status === 'Current' }]}>
              <div class="experience-card__meta"><span>{item.period}</span><small>{item.status}</small></div>
              <h3>{item.role}</h3>
              <h4>{item.organisation}</h4>
              <p>{item.summary}</p>
              {item.highlights.length > 0 && <ul>{item.highlights.map((highlight) => <li>{highlight}</li>)}</ul>}
              {item.links.length > 0 && <div class="cv-card__links">{item.links.map((link) => <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noreferrer' : undefined}>{link.label} ↗</a>)}</div>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="cv-block cv-block--surface">
      <div class="shell">
        <div class="cv-block__heading">
          <div><span class="eyebrow">Education</span><h2>Current studies and completed training.</h2></div>
          <p>Business studies and an international exchange, followed by completed professional coursework and an earlier foundation in aviation.</p>
        </div>
        <div class="education-grid">
          {education.map((item) => (
            <article class:list={["education-card", { "education-card--current": item.status === 'Current' }]}>
              <div class="education-card__meta"><span>{item.period}</span><small>{item.status}</small></div>
              <h3>{item.title}</h3>
              <p>{item.institution}</p>
              {item.links.length > 0 && <div class="cv-card__links">{item.links.map((link) => <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noreferrer' : undefined}>{link.label} ↗</a>)}</div>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="cv-block">
      <div class="shell languages-layout">
        <div class="cv-block__heading cv-block__heading--stacked">
          <div><span class="eyebrow">Languages</span><h2>Working across borders.</h2></div>
          <p>Languages used across study, professional work, mobility, and international teams.</p>
          <a class="button button--outline button--small" href="/certificates/">View all certificates</a>
        </div>
        <div class="language-grid">
          {languages.map((item) => (
            <article>
              <div class="language-card__topline">
                <span class="language-card__flag" aria-hidden="true">{item.flag}</span>
                <strong>{item.level}</strong>
              </div>
              <h3>{item.language}</h3>
              <p>{item.note}</p>
              {item.certificates.length > 0 && (
                <div class="language-card__links">
                  {item.certificates.map((certificate) => <a href={certificate.href}>{certificate.label} ↗</a>)}
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .cv-hero { padding: clamp(2.5rem, 5vw, 4.5rem) 0 clamp(2rem, 3.5vw, 3rem); }
  .cv-hero__grid { display: grid; grid-template-columns: minmax(12rem, 15rem) minmax(20rem, 1fr); gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  .cv-hero__portrait { overflow: hidden; border-radius: var(--radius-lg); background: var(--surface); }
  .cv-hero__portrait img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 28%; }
  .cv-hero__summary > p { max-width: 50rem; margin: 0; color: var(--ink); font-size: clamp(.95rem, 1.5vw, 1.08rem); line-height: 1.65; }
  .cv-hero__actions { display: flex; align-items: center; gap: 1rem; margin-top: 1.5rem; }

  .cv-snapshot { border-block: 1px solid var(--line); background: var(--surface); }
  .cv-snapshot__grid { display: grid; grid-template-columns: repeat(3, 1fr); }
  .cv-snapshot article { min-width: 0; padding: 1.25rem 1.5rem 1.25rem 0; border-right: 1px solid var(--line); }
  .cv-snapshot article + article { padding-left: 1.5rem; }
  .cv-snapshot article:last-child { border-right: 0; }
  .cv-snapshot span { display: block; margin-bottom: .55rem; color: var(--ink); font-size: .57rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; }
  .cv-snapshot strong { display: block; font-size: .9rem; line-height: 1.25; }
  .cv-snapshot p { margin: .28rem 0 0; color: var(--muted); font-size: .68rem; }

  .cv-block { padding: clamp(3.5rem, 7vw, 6.5rem) 0; }
  .cv-block + .cv-block { border-top: 1px solid var(--line); }
  .cv-block--surface { background: var(--surface); }
  .cv-block__heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(18rem, .7fr); gap: 2rem; align-items: end; margin-bottom: clamp(1.8rem, 4vw, 3rem); }
  .cv-block__heading h2 { margin: .45rem 0 0; font-size: clamp(1.8rem, 3.6vw, 3rem); line-height: 1; letter-spacing: -.055em; }
  .cv-block__heading > p { max-width: 36rem; margin: 0; color: var(--muted); font-size: .82rem; }

  .experience-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem; }
  .experience-card { min-width: 0; padding: 1.35rem; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--white); }
  .experience-card--current { border-top: 3px solid var(--accent); }
  .experience-card__meta { display: flex; justify-content: space-between; gap: 1rem; align-items: center; }
  .experience-card__meta > span { color: var(--muted); font-size: .66rem; font-variant-numeric: tabular-nums; }
  .experience-card__meta small { padding: .28rem .5rem; border-radius: 999px; color: var(--accent-dark); background: var(--blue-mist); font-size: .52rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .experience-card h3 { margin: 1.35rem 0 .35rem; font-size: 1.18rem; line-height: 1.15; letter-spacing: -.035em; }
  .experience-card h4 { margin: 0 0 .8rem; color: var(--accent-dark); font-size: .7rem; font-weight: 650; }
  .experience-card > p { margin: 0; color: var(--muted); font-size: .78rem; }
  .experience-card ul { margin: .8rem 0 0; padding-left: 1rem; color: var(--muted); font-size: .72rem; }
  .experience-card li + li { margin-top: .35rem; }
  .cv-card__links { display: flex; flex-wrap: wrap; gap: .55rem 1rem; margin-top: 1rem; padding-top: .85rem; border-top: 1px solid var(--line); }
  .cv-card__links a { color: var(--ink); font-size: .63rem; font-weight: 650; }
  .cv-card__links a:hover { color: var(--accent-dark); }

  .education-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem; }
  .education-grid article { min-height: 12rem; padding: 1.25rem; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--white); }
  .education-grid .education-card--current { border-top: 3px solid var(--accent); }
  .education-card__meta { display: flex; justify-content: space-between; gap: 1rem; align-items: center; }
  .education-card__meta span { color: var(--accent-dark); font-size: .64rem; font-weight: 650; }
  .education-card__meta small { padding: .28rem .5rem; border-radius: 999px; color: var(--accent-dark); background: var(--blue-mist); font-size: .52rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .education-grid h3 { margin: 3rem 0 .55rem; font-size: 1.05rem; line-height: 1.18; letter-spacing: -.03em; }
  .education-grid p { margin: 0; color: var(--muted); font-size: .72rem; }

  .languages-layout { display: grid; grid-template-columns: minmax(16rem, .8fr) 1.2fr; gap: clamp(2rem, 8vw, 7rem); align-items: start; }
  .cv-block__heading--stacked { grid-template-columns: 1fr; margin: 0; }
  .cv-block__heading--stacked .button { justify-self: start; margin-top: .2rem; }
  .language-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: .75rem; }
  .language-grid article { min-width: 0; display: flex; flex-direction: column; min-height: 10.5rem; padding: 1rem; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--white); }
  .language-card__topline { display: flex; justify-content: space-between; gap: 1rem; align-items: center; }
  .language-card__flag { font-size: 1.45rem; line-height: 1; }
  .language-card__topline strong { color: var(--accent-dark); font-size: .72rem; }
  .language-grid h3 { margin: 1rem 0 .25rem; font-size: 1rem; letter-spacing: -.025em; }
  .language-grid p { margin: 0; color: var(--muted); font-size: .65rem; }
  .language-card__links { display: flex; flex-wrap: wrap; gap: .4rem .8rem; margin-top: auto; padding-top: .85rem; }
  .language-card__links a { color: var(--ink); font-size: .6rem; font-weight: 650; }
  .language-card__links a:hover { color: var(--accent-dark); }

  @media (max-width: 800px) {
    .cv-hero__grid { grid-template-columns: 1fr; }
    .cv-hero__portrait { width: min(15rem, 100%); }
    .cv-block__heading, .languages-layout { grid-template-columns: 1fr; }
    .cv-snapshot__grid { grid-template-columns: 1fr; }
    .cv-snapshot article { padding-inline: 0 !important; border-right: 0; border-bottom: 1px solid var(--line); }
    .cv-snapshot article:last-child { border-bottom: 0; }
    .education-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 580px) {
    .experience-grid, .education-grid, .language-grid { grid-template-columns: 1fr; }
  }
</style>
