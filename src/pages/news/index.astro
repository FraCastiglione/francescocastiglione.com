---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsExplorer from '../../components/NewsExplorer.astro';

const posts = (await getCollection('news', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout title="News, Articles, and Publications — Francesco Castiglione" description="News, articles, publications, project stories, events, and professional updates from Francesco Castiglione.">
  <header class="collection-intro">
    <div class="shell collection-intro__inner news-intro__inner">
      <h1>News, Articles, and Publications</h1>
      <p>Project stories, professional updates, articles, events, and published work.</p>
    </div>
  </header>
  <section class="news-index">
    <div class="shell"><NewsExplorer posts={posts} /></div>
  </section>
</BaseLayout>

<style>
  .news-intro__inner { grid-template-columns: 1fr; gap: .65rem; align-items: start; }
  .news-intro__inner h1 { max-width: 58rem; }
  .news-intro__inner p { max-width: 42rem; margin: 0; }
  .news-index { padding: 0 0 clamp(6rem, 12vw, 10rem); }
</style>
