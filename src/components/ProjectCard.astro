---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
}

const { project } = Astro.props;
const { data } = project;
const physicalLocationLabel = [...new Set(data.locations.map((location) => `${location.city}, ${location.country}`))].join(' · ');
const locationLabel = physicalLocationLabel
  ? `${physicalLocationLabel}${data.deliveryMode === 'hybrid' ? ' · Online' : ''}`
  : data.deliveryMode === 'online' ? 'Online' : 'Locations to be added';
const visibleTags = data.skills.length ? data.skills.slice(0, 3) : [data.program, data.role];
const projectHref = `/projects/${project.id}/`;
const programName = data.program.toLowerCase();
const categoryKey = programName.includes('erasmus+')
  ? 'erasmus'
  : programName.includes('solidarity corps')
    ? 'esc'
    : programName.includes('national grant')
      ? 'national-grants'
    : ['horizon', 'digital europe', 'european parliament', 'europe for citizens', 'meeting memories', 'european project'].some((label) => programName.includes(label))
      ? 'eu-grants'
      : 'other';
const categoryLabel = categoryKey === 'erasmus' ? 'Erasmus+' : categoryKey === 'esc' ? 'European Solidarity Corps' : categoryKey === 'eu-grants' ? 'EU Grants' : categoryKey === 'national-grants' ? 'National Grants' : 'Other';
---

<article class:list={['project-card', `project-card--${categoryKey}`, { 'project-card--image': Boolean(data.image) }]} data-project-card data-project-id={project.id}>
  <div class="project-card__media">
      {data.image && <img src={data.image} alt={data.imageAlt ?? ''} loading="lazy" style={`object-fit: ${data.imageFit}; object-position: ${data.imagePosition ?? 'center center'}`} />}
      <div class="project-card__veil"></div>
      <div class="project-card__topline">
        <span>{data.yearLabel}</span>
        <span class="project-card__category" title={data.program}>{categoryLabel}</span>
      </div>
      <div class="project-card__headline">
        <p>{locationLabel}</p>
        <h3><a href={projectHref}>{data.title}</a></h3>
      </div>
  </div>

  <div class="project-card__body">
    <div class="project-card__meta"><span>{data.role}</span><span>{data.activityType}</span></div>
    <p class="project-card__summary">{data.summary}</p>
    <div class="tag-list" aria-label="Project skills">
      {visibleTags.map((tag) => <span>{tag}</span>)}
    </div>
    <div class="project-card__actions">
      <a class="project-card__details" href={projectHref}>View project <span>↗</span></a>
      {data.externalUrl && <a class="project-card__external" href={data.externalUrl} target="_blank" rel="noreferrer">Project website ↗</a>}
    </div>
  </div>
</article>

<style>
  .project-card {
    --category-color: #7182a2;
    --category-soft: #e8edf5;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 100%;
    border: 1px solid var(--line);
    border-top: 3px solid var(--category-color);
    border-radius: var(--radius-lg);
    background: var(--white);
    transition: transform 200ms var(--ease-out), border-color 180ms ease, box-shadow 180ms ease;
  }
  .project-card:hover { border-color: color-mix(in srgb, var(--accent) 32%, var(--line)); box-shadow: var(--shadow-lg); transform: translateY(-3px); }

  .project-card__media {
    position: relative;
    overflow: hidden;
    min-height: 20rem;
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    color: var(--blue-deep);
    background:
      radial-gradient(circle at 78% 18%, rgba(255,255,255,.2), transparent 30%),
      linear-gradient(145deg, #f4f7fb, var(--category-soft));
  }

  .project-card--erasmus { --category-color: #4f70cc; --category-soft: #b9cdf6; }
  .project-card--esc { --category-color: #278b78; --category-soft: #b9e3d9; }
  .project-card--eu-grants { --category-color: #c27b2a; --category-soft: #f0d3ab; }
  .project-card--national-grants { --category-color: #b65362; --category-soft: #f2ced4; }
  .project-card--other { --category-color: #7c60a8; --category-soft: #d8caee; }
  .project-card--image .project-card__media { color: var(--white); }

  .project-card__media::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.34;
    background-image:
      linear-gradient(rgba(255,255,255,.15) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.15) 1px, transparent 1px);
    background-size: 4rem 4rem;
    transform: scale(1.08) rotate(-5deg);
  }

  .project-card__media img {
    position: absolute;
    inset: -3%;
    width: 106%;
    height: 106%;
    object-fit: cover;
    filter: saturate(.84) brightness(.82);
    transform: scale(1.02);
    transition: transform 520ms var(--ease-out), filter 280ms ease;
  }
  .project-card:hover .project-card__media img { filter: saturate(.92) brightness(.86); transform: scale(1.045); }

  .project-card__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(49, 69, 99, .03), rgba(49, 69, 99, .06) 35%, rgba(49, 69, 99, .18));
  }
  .project-card--image .project-card__veil { background: linear-gradient(180deg, rgba(30, 42, 60, .22), rgba(30, 42, 60, .12) 35%, rgba(30, 42, 60, .76)); }

  .project-card__topline,
  .project-card__headline { position: relative; z-index: 1; }

  .project-card__topline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: color-mix(in srgb, currentColor 82%, transparent);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .project-card__topline span:last-child { text-align: right; }
  .project-card__category { padding: .3rem .48rem; border-radius: 999px; color: var(--white); background: var(--category-color); font-size: .58rem; letter-spacing: .05em; }

  .project-card__headline { margin-top: auto; padding-top: 4rem; }
  .project-card__headline > p {
    margin: 0 0 0.85rem;
    color: color-mix(in srgb, currentColor 70%, transparent);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .project-card h3 {
    margin: 0;
    font-size: clamp(1.65rem, 3.2vw, 2.35rem);
    line-height: 1;
    letter-spacing: -0.055em;
  }
  .project-card h3 a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .14em; }

  .project-card__body { flex: 1; display: flex; flex-direction: column; padding: 1.2rem 1.25rem 1.3rem; }
  .project-card__meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .4rem 1rem; color: var(--category-color); font-size: .64rem; font-weight: 700; letter-spacing: .045em; text-transform: uppercase; }
  .project-card__summary { margin: .9rem 0 0; color: var(--muted); font-size: .8rem; line-height: 1.6; }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1rem;
  }

  .tag-list span {
    padding: 0.42rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    background: var(--surface);
    font-size: 0.64rem;
  }

  .project-card__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.15rem;
    border-top: 1px solid var(--line);
  }
  .project-card__details { display: flex; justify-content: space-between; gap: 1rem; color: var(--ink); font-size: .72rem; font-weight: 700; }
  .project-card__details:hover, .project-card__external:hover { color: var(--accent-dark); }
  .project-card__external { color: var(--muted); font-size: .67rem; font-weight: 650; }

  @media (prefers-reduced-motion: reduce) {
    .project-card:hover { transform: none; }
    .project-card:hover .project-card__media img { transform: scale(1.02); }
  }
</style>
