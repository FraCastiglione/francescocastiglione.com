---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const { data } = project;
const physicalLocationLabel = [...new Set(data.locations.map((location) => `${location.city}, ${location.country}`))].join(' · ');
const locationLabel = physicalLocationLabel
  ? `${physicalLocationLabel}${data.deliveryMode === 'hybrid' ? ' · Online' : ''}`
  : data.deliveryMode === 'online' ? 'Online' : 'Locations to be added';
const visibleTags = data.skills.length ? data.skills.slice(0, 3) : [data.program, data.role];
const projectHref = `/projects/${project.id}/`;
const tone = (index % 4) + 1;
---

<article class:list={['project-card', `project-card--tone-${tone}`, { 'project-card--image': Boolean(data.image) }]} data-project-card data-project-id={project.id}>
  <div class="project-card__inner">
    <div class="project-card__face project-card__front">
      {data.image && <img src={data.image} alt={data.imageAlt ?? ''} loading="lazy" />}
      <div class="project-card__veil"></div>
      <div class="project-card__topline">
        <span>{data.yearLabel}</span>
        <span>{data.program}</span>
      </div>
      <div class="project-card__front-copy">
        <p>{locationLabel}</p>
        <h3><a href={projectHref}>{data.title}</a></h3>
        <div class="tag-list" aria-label="Project attributes">
          {visibleTags.map((tag) => <span>{tag}</span>)}
        </div>
      </div>
      <button class="project-card__flip" type="button" data-card-toggle aria-expanded="false" aria-label={`Show details for ${data.title}`}>
        <span>Project view</span>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10h10M11 6l4 4-4 4" /></svg>
      </button>
    </div>

    <div class="project-card__face project-card__back">
      <div class="project-card__topline">
        <span>{data.role}</span>
        <span>{data.activityType}</span>
      </div>
      <div class="project-card__back-copy">
        <p class="eyebrow">The short version</p>
        <h3>{data.title}</h3>
        <p>{data.summary}</p>
      </div>
      <div class="project-card__actions">
        <a class="button button--light button--small" href={projectHref}>More details</a>
        {data.externalUrl && <a class="text-link text-link--light" href={data.externalUrl} target="_blank" rel="noreferrer">Project website ↗</a>}
      </div>
      <button class="project-card__close" type="button" data-card-toggle aria-expanded="false" aria-label={`Show front of ${data.title}`}>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10h10M9 6l-4 4 4 4" /></svg>
      </button>
    </div>
  </div>
</article>

<style>
  .project-card {
    min-height: 31rem;
    perspective: 1200px;
  }

  .project-card__inner {
    position: relative;
    width: 100%;
    min-height: 31rem;
    transform-style: preserve-3d;
    transition: transform 620ms var(--ease-out);
  }

  .project-card.is-flipped .project-card__inner { transform: rotateY(180deg); }

  .project-card__face {
    position: absolute;
    inset: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 1.35rem;
    border-radius: var(--radius-lg);
    backface-visibility: hidden;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
  }

  .project-card__front {
    color: var(--blue-deep);
    background:
      radial-gradient(circle at 78% 18%, rgba(255,255,255,.2), transparent 30%),
      linear-gradient(145deg, var(--card-a), var(--card-b));
  }

  .project-card--tone-1 { --card-a: #dcecff; --card-b: #9dc4f1; }
  .project-card--tone-2 { --card-a: #e8f2ff; --card-b: #b2d2f3; }
  .project-card--tone-3 { --card-a: #d8e9fb; --card-b: #8eb6e1; }
  .project-card--tone-4 { --card-a: #edf5ff; --card-b: #bdd8f3; }
  .project-card--image .project-card__front { color: var(--white); }

  .project-card__front::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.34;
    background-image:
      linear-gradient(rgba(255,255,255,.15) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.15) 1px, transparent 1px);
    background-size: 4rem 4rem;
    transform: scale(1.08) rotate(-5deg);
  }

  .project-card__front img {
    position: absolute;
    inset: -3%;
    width: 106%;
    height: 106%;
    object-fit: cover;
    filter: blur(3px) saturate(0.8);
    transform: scale(1.04);
  }

  .project-card__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(49, 69, 99, .03), rgba(49, 69, 99, .06) 35%, rgba(49, 69, 99, .18));
  }
  .project-card--image .project-card__veil { background: linear-gradient(180deg, rgba(30, 42, 60, .22), rgba(30, 42, 60, .12) 35%, rgba(30, 42, 60, .76)); }

  .project-card__topline,
  .project-card__front-copy,
  .project-card__flip { position: relative; z-index: 1; }

  .project-card__topline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: color-mix(in srgb, currentColor 82%, transparent);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .project-card__topline span:last-child { text-align: right; }

  .project-card__front-copy { margin-top: auto; padding: 5rem 0 0; }
  .project-card__front-copy > p {
    margin: 0 0 0.85rem;
    color: color-mix(in srgb, currentColor 70%, transparent);
    font-size: 0.78rem;
  }

  .project-card h3 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.65rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .project-card h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.35rem;
  }

  .tag-list span {
    padding: 0.42rem 0.65rem;
    border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.24);
    backdrop-filter: blur(8px);
    color: currentColor;
    font-size: 0.67rem;
  }

  .project-card__flip {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.3rem;
    padding: 0.95rem 0 0;
    border: 0;
    border-top: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    color: currentColor;
    background: transparent;
    font: inherit;
    font-size: 0.74rem;
    cursor: pointer;
  }

  .project-card__flip svg,
  .project-card__close svg {
    width: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .project-card__back {
    color: var(--white);
    background: #174a7e;
    transform: rotateY(180deg);
  }

  .project-card__back-copy {
    margin: auto 0;
  }

  .project-card__back-copy .eyebrow { color: rgba(255,255,255,.5); }
  .project-card__back-copy h3 { margin-top: 0.65rem; }
  .project-card__back-copy > p:last-child {
    margin: 1.2rem 0 1.6rem;
    color: rgba(255,255,255,.7);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .project-card__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .project-card__close {
    position: absolute;
    top: 3.4rem;
    right: 1.35rem;
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255,255,255,.2);
    border-radius: 50%;
    color: var(--white);
    background: transparent;
    cursor: pointer;
  }

  @media (hover: hover) and (pointer: fine) {
    .project-card:hover .project-card__inner,
    .project-card:focus-within .project-card__inner { transform: rotateY(180deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card__inner { transition-duration: 0.01ms; }
  }
</style>
