---
import type { CollectionEntry } from 'astro:content';

interface Props { posts: CollectionEntry<'news'>[]; }
const { posts } = Astro.props;
const categories = [...new Set(posts.map((post) => post.data.category))].sort((a, b) => a.localeCompare(b));
const years = [...new Set(posts.map((post) => String(post.data.publishedAt.getUTCFullYear())))].sort((a, b) => Number(b) - Number(a));
const formatDate = (post: CollectionEntry<'news'>) => post.data.dateLabel ?? post.data.publishedAt.toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});
---

<section class="news-explorer" data-news-explorer>
  <div class="news-explorer__tools">
    <label class="news-search">
      <span class="sr-only">Search news, articles, and publications</span>
      <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"></circle><path d="m13 13 4 4"></path></svg>
      <input type="search" placeholder="Search news, articles, and publications" data-news-search />
    </label>

    <div class="news-filters" aria-label="Filter articles and updates">
      <label><span class="sr-only">Type</span><select data-news-filter="category"><option value="">All types</option>{categories.map((category) => <option value={category}>{category[0].toUpperCase() + category.slice(1)}</option>)}</select></label>
      <label><span class="sr-only">Year</span><select data-news-filter="year"><option value="">All years</option>{years.map((year) => <option value={year}>{year}</option>)}</select></label>
    </div>

    <div class="news-view-switcher" aria-label="Article view">
      <button type="button" data-news-view="cards" aria-pressed="true">
        <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="2" y="2" width="7" height="7"></rect><rect x="11" y="2" width="7" height="7"></rect><rect x="2" y="11" width="7" height="7"></rect><rect x="11" y="11" width="7" height="7"></rect></svg>
        <span>Cards</span>
      </button>
      <button type="button" data-news-view="list" aria-pressed="false">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M2 4h16M2 10h16M2 16h16"></path></svg>
        <span>List</span>
      </button>
    </div>
  </div>

  <div class="news-explorer__summary" aria-live="polite">
    <span><strong data-news-count>{posts.length}</strong> <span data-news-count-label>{posts.length === 1 ? 'entry' : 'entries'}</span></span>
    <button type="button" data-news-reset hidden>Clear filters</button>
  </div>

  <div class="news-grid" data-news-panel="cards">
    {posts.map((post) => (
      <article
        class="news-card"
        data-news-item
        data-news-id={post.id}
        data-search={`${post.data.title} ${post.data.summary} ${post.data.category} ${formatDate(post)}`.toLowerCase()}
        data-category={post.data.category}
        data-year={String(post.data.publishedAt.getUTCFullYear())}
      >
        <a class:list={['news-card__media', { 'news-card__media--placeholder': !post.data.image }]} href={`/news/${post.id}/`} aria-label={`Read ${post.data.title}`}>
          {post.data.image ? <img src={post.data.image} alt={post.data.imageAlt ?? ''} loading="lazy" decoding="async" /> : <span>{post.data.category}</span>}
        </a>
        <div class="news-card__body">
          <div class="news-card__meta"><span>{post.data.category}</span><time datetime={post.data.publishedAt.toISOString()}>{formatDate(post)}</time></div>
          <h2><a href={`/news/${post.id}/`}>{post.data.title}</a></h2>
          <p>{post.data.summary}</p>
          <a class="news-card__link" href={`/news/${post.id}/`}>Read more <span>↗</span></a>
        </div>
      </article>
    ))}
  </div>

  <div class="news-list" data-news-panel="list" hidden>
    {posts.map((post) => (
      <article
        class="news-row"
        data-news-item
        data-news-id={post.id}
        data-search={`${post.data.title} ${post.data.summary} ${post.data.category} ${formatDate(post)}`.toLowerCase()}
        data-category={post.data.category}
        data-year={String(post.data.publishedAt.getUTCFullYear())}
      >
        <a class:list={['news-row__media', { 'news-row__media--placeholder': !post.data.image }]} href={`/news/${post.id}/`} tabindex="-1" aria-hidden="true">
          {post.data.image ? <img src={post.data.image} alt="" loading="lazy" decoding="async" /> : <span>{post.data.category}</span>}
        </a>
        <div class="news-row__meta"><span>{post.data.category}</span><time datetime={post.data.publishedAt.toISOString()}>{formatDate(post)}</time></div>
        <div class="news-row__copy"><h2><a href={`/news/${post.id}/`}>{post.data.title}</a></h2><p>{post.data.summary}</p></div>
        <a class="news-row__arrow" href={`/news/${post.id}/`} aria-label={`Read ${post.data.title}`}>↗</a>
      </article>
    ))}
  </div>

  <div class="news-empty" data-news-empty hidden><strong>No matching entries.</strong><p>Try another search term or clear the filters.</p></div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-news-explorer]').forEach((explorer) => {
    const search = explorer.querySelector<HTMLInputElement>('[data-news-search]');
    const filters = [...explorer.querySelectorAll<HTMLSelectElement>('[data-news-filter]')];
    const items = [...explorer.querySelectorAll<HTMLElement>('[data-news-item]')];
    const count = explorer.querySelector<HTMLElement>('[data-news-count]');
    const countLabel = explorer.querySelector<HTMLElement>('[data-news-count-label]');
    const reset = explorer.querySelector<HTMLButtonElement>('[data-news-reset]');
    const empty = explorer.querySelector<HTMLElement>('[data-news-empty]');

    const applyFilters = () => {
      const query = search?.value.trim().toLowerCase() ?? '';
      const selected = Object.fromEntries(filters.map((filter) => [filter.dataset.newsFilter ?? '', filter.value]));
      const visibleIds = new Set<string>();
      items.forEach((item) => {
        const matchesSearch = !query || (item.dataset.search ?? '').includes(query);
        const matchesFilters = Object.entries(selected).every(([key, value]) => !value || item.dataset[key] === value);
        const visible = matchesSearch && matchesFilters;
        item.hidden = !visible;
        if (visible && item.dataset.newsId) visibleIds.add(item.dataset.newsId);
      });
      if (count) count.textContent = String(visibleIds.size);
      if (countLabel) countLabel.textContent = visibleIds.size === 1 ? 'entry' : 'entries';
      if (empty) empty.hidden = visibleIds.size > 0;
      if (reset) reset.hidden = !query && filters.every((filter) => !filter.value);
    };

    search?.addEventListener('input', applyFilters);
    filters.forEach((filter) => filter.addEventListener('change', applyFilters));
    reset?.addEventListener('click', () => {
      if (search) search.value = '';
      filters.forEach((filter) => { filter.value = ''; });
      search?.focus();
      applyFilters();
    });
    explorer.querySelectorAll<HTMLButtonElement>('[data-news-view]').forEach((button) => {
      button.addEventListener('click', () => {
        const view = button.dataset.newsView;
        explorer.querySelectorAll<HTMLButtonElement>('[data-news-view]').forEach((control) => control.setAttribute('aria-pressed', String(control === button)));
        explorer.querySelectorAll<HTMLElement>('[data-news-panel]').forEach((panel) => { panel.hidden = panel.dataset.newsPanel !== view; });
      });
    });
    applyFilters();
  });
</script>

<style>
  .news-explorer__tools { display: grid; grid-template-columns: minmax(13rem, 1fr) auto auto; gap: .75rem; align-items: center; padding: .75rem; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--white); }
  .news-search { min-width: 0; display: flex; align-items: center; gap: .65rem; padding: 0 .55rem; }
  .news-search svg { width: 1.1rem; flex: none; fill: none; stroke: var(--muted); stroke-width: 1.5; }
  .news-search input { width: 100%; padding: .55rem 0; border: 0; outline: 0; color: var(--ink); background: transparent; font-size: .84rem; }
  .news-filters { display: flex; gap: .45rem; }
  .news-filters select { max-width: 10rem; padding: .68rem 2rem .68rem .78rem; border: 1px solid var(--line); border-radius: .68rem; color: var(--ink); background: var(--surface); font-size: .72rem; text-transform: capitalize; }
  .news-view-switcher { display: flex; padding-left: .7rem; border-left: 1px solid var(--line); }
  .news-view-switcher button { display: flex; align-items: center; gap: .4rem; padding: .62rem .7rem; border: 0; border-radius: .55rem; color: var(--muted); background: transparent; font-size: .72rem; cursor: pointer; }
  .news-view-switcher button[aria-pressed='true'] { color: var(--ink); background: var(--surface-strong); }
  .news-view-switcher svg { width: 1rem; fill: none; stroke: currentColor; stroke-width: 1.35; }
  .news-explorer__summary { display: flex; align-items: center; min-height: 3.5rem; color: var(--muted); font-size: .73rem; }
  .news-explorer__summary strong { color: var(--ink); }
  .news-explorer__summary button { margin-left: auto; padding: .35rem 0; border: 0; border-bottom: 1px solid currentColor; color: var(--accent-dark); background: transparent; font-size: .68rem; cursor: pointer; }

  .news-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .news-card { min-width: 0; overflow: hidden; display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--white); transition: transform 180ms var(--ease-out), border-color 180ms ease, box-shadow 180ms ease; }
  .news-card:hover { border-color: color-mix(in srgb, var(--accent) 30%, var(--line)); box-shadow: var(--shadow-lg); transform: translateY(-3px); }
  .news-card__media { overflow: hidden; display: block; aspect-ratio: 16 / 10; background: var(--surface-strong); }
  .news-card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 420ms var(--ease-out); }
  .news-card:hover .news-card__media img { transform: scale(1.025); }
  .news-card__media--placeholder { display: grid; place-items: end start; padding: 1.2rem; color: var(--blue-deep); background: linear-gradient(145deg, var(--blue-soft), #b8cef5); }
  .news-card__media--placeholder span { font-size: .65rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .news-card__body { flex: 1; display: flex; flex-direction: column; padding: 1.25rem; }
  .news-card__meta { display: flex; justify-content: space-between; gap: 1rem; color: var(--muted); font-size: .63rem; }
  .news-card__meta span { color: var(--accent-dark); font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .news-card h2 { margin: .8rem 0 .65rem; font-size: clamp(1.25rem, 2vw, 1.65rem); line-height: 1.08; letter-spacing: -.04em; }
  .news-card h2 a:hover { color: var(--accent-dark); }
  .news-card p { margin: 0; color: var(--muted); font-size: .78rem; line-height: 1.6; }
  .news-card__link { display: flex; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: 1.2rem; color: var(--ink); font-size: .7rem; font-weight: 650; }

  .news-list { border-top: 1px solid var(--line); }
  .news-row { display: grid; grid-template-columns: 8rem 8rem minmax(0, 1fr) 2rem; gap: 1.5rem; align-items: center; padding: 1.15rem 0; border-bottom: 1px solid var(--line); }
  .news-row__media { overflow: hidden; display: block; aspect-ratio: 4 / 3; border-radius: var(--radius-sm); background: var(--surface-strong); }
  .news-row__media img { width: 100%; height: 100%; object-fit: cover; }
  .news-row__media--placeholder { display: grid; place-items: center; color: var(--accent-dark); background: var(--blue-soft); font-size: .55rem; font-weight: 700; text-transform: uppercase; }
  .news-row__meta { display: grid; gap: .28rem; color: var(--muted); font-size: .65rem; }
  .news-row__meta span { color: var(--accent-dark); font-weight: 700; text-transform: capitalize; }
  .news-row h2 { margin: 0; font-size: 1.05rem; line-height: 1.2; letter-spacing: -.03em; }
  .news-row h2 a:hover { color: var(--accent-dark); }
  .news-row p { max-width: 48rem; margin: .35rem 0 0; color: var(--muted); font-size: .74rem; }
  .news-row__arrow { text-align: right; }
  .news-empty { padding: 5rem 1rem; text-align: center; }
  .news-empty p { margin: .45rem 0 0; color: var(--muted); font-size: .8rem; }

  @media (max-width: 1000px) { .news-explorer__tools { grid-template-columns: 1fr auto; } .news-filters { grid-column: 1 / -1; grid-row: 2; } .news-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 700px) {
    .news-grid { grid-template-columns: 1fr; }
    .news-view-switcher button span { display: none; }
    .news-filters label, .news-filters select { min-width: 0; width: 100%; max-width: none; }
    .news-row { grid-template-columns: 5rem minmax(0, 1fr) 1.5rem; gap: .8rem; }
    .news-row__meta { grid-column: 2; grid-row: 1; align-self: start; }
    .news-row__copy { grid-column: 2; }
    .news-row__media { grid-row: 1 / 3; }
    .news-row__arrow { grid-column: 3; grid-row: 1 / 3; }
    .news-row p { display: none; }
  }
</style>
