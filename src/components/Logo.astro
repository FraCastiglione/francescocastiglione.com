---
import Wordmark from './Wordmark.astro';

interface Props {
  compact?: boolean;
  light?: boolean;
}

const { compact = false, light = false } = Astro.props;
---

<span class:list={['logo', { 'logo--compact': compact, 'logo--light': light }]}>
  <Wordmark compact={compact} light={light} />
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
  }
</style>
