---
import Wordmark from './Wordmark.astro';

interface Props {
  compact?: boolean;
  hero?: boolean;
  light?: boolean;
}

const { compact = false, hero = false, light = false } = Astro.props;
---

<span class:list={['logo', { 'logo--compact': compact, 'logo--hero': hero, 'logo--light': light }]}>
  {hero ? (
    <img
      class="logo__hero-lockup"
      src="/brand/francesco-castiglione-horizontal.svg"
      alt="Francesco Castiglione"
      width="2423"
      height="520"
    />
  ) : (
    <>
      <img class="logo__symbol" src="/brand/european-superhero-mark.svg" alt="" aria-hidden="true" width="1200" height="1057" />
      <span class="logo__divider" aria-hidden="true"></span>
      <Wordmark compact={compact} brand light={light} />
    </>
  )}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.68rem;
    line-height: 1;
  }

  .logo__symbol {
    width: 2.75rem;
    height: 2.45rem;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .logo--hero {
    width: min(100%, 45rem);
  }

  .logo__hero-lockup {
    width: 100%;
    height: auto;
  }

  .logo__divider {
    width: 1px;
    height: 1.72rem;
    flex: 0 0 auto;
    background: color-mix(in srgb, #003399 48%, transparent);
  }

  .logo--light .logo__symbol {
    filter: brightness(0) invert(1);
  }

  .logo--light .logo__divider {
    background: rgba(255, 255, 255, 0.52);
  }

  @media (max-width: 480px) {
    .logo { gap: 0.55rem; }
    .logo__symbol { width: 2.45rem; height: 2.15rem; }
    .logo__divider { height: 1.5rem; }
  }
</style>
