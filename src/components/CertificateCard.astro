---
import type { CollectionEntry } from 'astro:content';

interface RelatedProject {
  id: string;
  title: string;
}

interface Props {
  certificate: CollectionEntry<'certificates'>;
  index?: number;
  relatedProjects?: RelatedProject[];
  compact?: boolean;
}

const {
  certificate,
  index = 0,
  relatedProjects = [],
  compact = false,
} = Astro.props;
const { data } = certificate;
const locationLabel = data.locations.length
  ? [...new Set(data.locations.map((location) => `${location.city}, ${location.country}`))].join(' · ')
  : '';
const documentLabel = data.documentCount === 1 ? '1 document' : `${data.documentCount} documents`;
const pageLabel = data.pageCount ? `${data.pageCount} ${data.pageCount === 1 ? 'page' : 'pages'}` : '';
const deliveryLabel = data.deliveryMode === 'in-person'
  ? 'In person'
  : data.deliveryMode === 'online' ? 'Online' : data.deliveryMode === 'hybrid' ? 'Hybrid' : data.deliveryMode;
const details = [data.activityType, deliveryLabel, locationLabel, documentLabel, pageLabel].filter(Boolean);
const publicPreview = data.documentStatus === 'public' ? data.previewImage : undefined;
const publicDocuments = data.documentStatus === 'public'
  ? data.documents.length > 0
    ? data.documents
    : data.pdfPath
      ? [{ label: 'Certificate', path: data.pdfPath, pages: data.pageCount }]
      : []
  : [];
---

<article class:list={['certificate-card', { 'certificate-card--compact': compact }]}>
  <div class:list={['certificate-card__cover', { 'certificate-card__cover--image': Boolean(publicPreview) }]}>
    {publicPreview ? (
      <img src={publicPreview} alt={data.previewAlt ?? `Preview of ${data.title}`} loading="lazy" />
    ) : (
      <div class="certificate-cover" aria-hidden="true">
        <div class="certificate-cover__topline">
          <span>{data.category}</span>
          <span>{String(index + 1).padStart(2, '0')}</span>
        </div>
        <svg class="certificate-cover__mark" viewBox="0 0 96 96">
          <circle cx="48" cy="48" r="34"></circle>
          <circle cx="48" cy="48" r="26"></circle>
          <path d="M59 37c-3-3-7-5-12-5-9 0-16 7-16 16s7 16 16 16c5 0 9-2 12-5"></path>
        </svg>
        <div class="certificate-cover__lines"><span></span><span></span><span></span></div>
      </div>
    )}
    <span class:list={['certificate-card__status', { 'is-public': data.documentStatus === 'public' }]}>
      {data.documentStatus === 'public' ? 'Public document' : 'Privacy review'}
    </span>
  </div>

  <div class="certificate-card__content">
    <div class="certificate-card__heading">
      <span class="eyebrow">{data.issuer} · {data.issued}</span>
      <h2>{data.title}</h2>
      <p>{data.summary}</p>
    </div>

    <div class="certificate-card__meta" aria-label="Credential details">
      {details.map((detail) => <span>{detail}</span>)}
    </div>

    {data.skills.length > 0 && (
      <div class="pill-list" aria-label="Skills">
        {data.skills.slice(0, compact ? 3 : 5).map((skill) => <span class="pill">{skill}</span>)}
      </div>
    )}

    {relatedProjects.length > 0 && (
      <div class="certificate-card__projects">
        <span>Related projects</span>
        <div>
          {relatedProjects.map((project) => <a href={`/projects/${project.id}/`}>{project.title}</a>)}
        </div>
      </div>
    )}

    <div class="certificate-card__actions">
      {publicDocuments.length > 0 ? (
        <div class="certificate-card__documents">
          {publicDocuments.map((document) => (
            <div class="certificate-card__document-actions">
              {publicDocuments.length > 1 && <span>{document.label}</span>}
              <a class="text-link" href={document.path} target="_blank" rel="noreferrer">View PDF ↗</a>
              <a class="text-link text-link--quiet" href={document.path} download>Download</a>
            </div>
          ))}
        </div>
      ) : (
        <span class="certificate-card__review">Document undergoing privacy review</span>
      )}
      {data.credentialUrl && (
        <a class="text-link" href={data.credentialUrl} target="_blank" rel="noreferrer">Credential ↗</a>
      )}
    </div>
  </div>
</article>

<style>
  .certificate-card {
    min-width: 0;
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
  }

  .certificate-card__cover {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    padding: 1rem;
    color: var(--blue-deep);
    background:
      radial-gradient(circle at 82% 15%, rgba(64, 104, 200, .15), transparent 32%),
      linear-gradient(145deg, #f8fbff, #e8f0fa);
  }

  .certificate-card__cover::after {
    content: '';
    position: absolute;
    inset: .7rem;
    border: 1px solid rgba(64, 104, 200, .2);
    border-radius: .8rem;
    pointer-events: none;
  }

  .certificate-card__cover--image { padding: .7rem; background: #edf2f8; }
  .certificate-card__cover--image::after { border-color: rgba(64,104,200,.18); }
  .certificate-card__cover img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 .4rem .7rem rgba(23, 42, 72, .13));
  }

  .certificate-cover { height: 100%; display: grid; grid-template-rows: auto 1fr auto; padding: .35rem; }
  .certificate-cover__topline { display: flex; justify-content: space-between; gap: 1rem; font-size: .6rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .certificate-cover__mark {
    width: clamp(3.4rem, 7vw, 5.3rem);
    align-self: center;
    justify-self: center;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.35;
  }
  .certificate-cover__mark circle:last-of-type { opacity: .35; stroke-dasharray: 2 4; }
  .certificate-cover__lines { width: 34%; display: grid; gap: .27rem; }
  .certificate-cover__lines span { height: 1px; background: rgba(41,74,145,.28); }
  .certificate-cover__lines span:nth-child(2) { width: 78%; }
  .certificate-cover__lines span:nth-child(3) { width: 52%; }

  .certificate-card__status {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 1;
    padding: .35rem .55rem;
    border: 1px solid rgba(23,23,23,.1);
    border-radius: 999px;
    color: var(--muted);
    background: rgba(255,255,255,.9);
    backdrop-filter: blur(10px);
    font-size: .57rem;
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
  }
  .certificate-card__status.is-public { color: var(--accent-dark); }

  .certificate-card__content { min-width: 0; display: flex; flex-direction: column; padding: 1.25rem; }
  .certificate-card__heading h2 {
    margin: .6rem 0 .65rem;
    font-size: clamp(1.25rem, 2.1vw, 1.55rem);
    line-height: 1.08;
    letter-spacing: -.04em;
  }
  .certificate-card__heading p { margin: 0; color: var(--muted); font-size: .78rem; line-height: 1.55; }

  .certificate-card__meta { display: flex; flex-wrap: wrap; gap: .35rem .9rem; margin-top: 1rem; color: var(--muted); font-size: .65rem; }
  .certificate-card__meta span { position: relative; }
  .certificate-card__meta span:not(:last-child)::after { content: '·'; position: absolute; right: -.58rem; color: var(--soft); }

  .certificate-card .pill-list { margin-top: 1rem; }
  .certificate-card .pill { padding: .36rem .58rem; font-size: .62rem; }

  .certificate-card__projects { margin-top: 1.1rem; padding-top: .9rem; border-top: 1px solid var(--line); }
  .certificate-card__projects > span { display: block; margin-bottom: .45rem; color: var(--muted); font-size: .61rem; }
  .certificate-card__projects > div { display: flex; flex-wrap: wrap; gap: .38rem; }
  .certificate-card__projects a { padding: .35rem .55rem; border-radius: 999px; color: var(--blue-deep); background: var(--blue-soft); font-size: .62rem; font-weight: 650; }
  .certificate-card__projects a:hover { color: var(--white); background: var(--accent); }

  .certificate-card__actions {
    min-height: 2.1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: .65rem 1rem;
    margin-top: auto;
    padding-top: 1.15rem;
  }
  .certificate-card__documents { display: grid; gap: .55rem; }
  .certificate-card__document-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem .8rem; }
  .certificate-card__document-actions > span { flex-basis: 100%; color: var(--muted); font-size: .61rem; }
  .certificate-card .text-link { font-size: .68rem; }
  .certificate-card .text-link--quiet { color: var(--muted); }
  .certificate-card__review { color: var(--muted); font-size: .66rem; }

  .certificate-card--compact .certificate-card__cover { aspect-ratio: 2 / 1; }
  .certificate-card--compact .certificate-card__heading p { display: none; }

  @media (max-width: 520px) {
    .certificate-card__content { padding: 1.1rem; }
    .certificate-card__actions { align-items: start; flex-direction: column; }
  }
</style>
