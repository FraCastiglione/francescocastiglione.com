---
interface Props {
  compact?: boolean;
  hero?: boolean;
  light?: boolean;
}

const { compact = false, hero = false, light = false } = Astro.props;
---

<span class:list={['wordmark', { 'wordmark--compact': compact, 'wordmark--hero': hero, 'wordmark--light': light }]}>
  <span>Francesco</span> <strong>Castiglione</strong>
</span>

<style>
  .wordmark {
    position: relative;
    display: inline-block;
    padding-bottom: .2em;
    color: var(--ink);
    font-size: .98rem;
    font-weight: 450;
    line-height: 1;
    letter-spacing: -.035em;
    white-space: nowrap;
  }

  .wordmark::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    width: 2.2em;
    height: .1276em;
    border-radius: .1276em;
    background: var(--accent);
  }

  .wordmark strong { font-weight: 720; }
  .wordmark--light { color: var(--white); }
  .wordmark--compact > span { display: none; }

  .wordmark--hero {
    font-size: clamp(2.05rem, 4.5vw, 4rem);
  }

  @media (max-width: 650px) {
    .wordmark--hero { font-size: clamp(1.9rem, 8vw, 2.3rem); }
  }

  @media (max-width: 480px) {
    .wordmark:not(.wordmark--hero) { font-size: .84rem; }
  }
</style>
