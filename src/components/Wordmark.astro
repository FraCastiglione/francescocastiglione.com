---
interface Props {
  compact?: boolean;
  hero?: boolean;
  light?: boolean;
  brand?: boolean;
}

const { compact = false, hero = false, light = false, brand = false } = Astro.props;
---

<span class:list={['wordmark', { 'wordmark--compact': compact, 'wordmark--hero': hero, 'wordmark--brand': brand, 'wordmark--light': light }]}> 
  <span>Francesco</span> <strong>Castiglione</strong>
</span>

<style>
  .wordmark {
    display: inline-block;
    color: var(--ink);
    font-size: .98rem;
    font-weight: 430;
    line-height: 1;
    letter-spacing: -.018em;
    white-space: nowrap;
  }

  .wordmark strong { font-weight: 620; }
  .wordmark--brand { color: #003399; }
  .wordmark--light { color: var(--white); }
  .wordmark--compact > span { display: none; }

  .wordmark--hero {
    font-size: clamp(2.05rem, 4.5vw, 4rem);
  }

  @media (max-width: 650px) {
    .wordmark--hero { font-size: clamp(1.9rem, 8vw, 2.3rem); }
  }

  @media (max-width: 480px) {
    .wordmark:not(.wordmark--hero) { font-size: .84rem; }
  }
</style>
