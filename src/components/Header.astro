---
import Logo from './Logo.astro';

const pathname = Astro.url.pathname;
const links = [
  { href: '/about/', label: 'About' },
  { href: '/projects/', label: 'Projects' },
  { href: '/cv/', label: 'CV' },
  { href: '/certificates/', label: 'Certificates' },
  { href: '/news/', label: 'News' },
];

const isActive = (href: string) => pathname === href || (href !== '/' && pathname.startsWith(href));
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Francesco Castiglione, home">
      <Logo />
    </a>

    <nav class="site-header__nav" aria-label="Primary navigation">
      {links.map((link) => (
        <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>

    <a class="button button--small site-header__contact" href="/contact/">Get in touch</a>

    <details class="site-header__menu">
      <summary aria-label="Open navigation">
        <span></span><span></span>
      </summary>
      <nav aria-label="Mobile navigation">
        {links.map((link) => (
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>
        ))}
        <a href="/contact/">Get in touch</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid color-mix(in srgb, var(--line) 82%, transparent);
    background: color-mix(in srgb, var(--white) 88%, transparent);
    backdrop-filter: blur(18px);
  }

  .site-header__inner {
    min-height: 4.8rem;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .site-header__brand { margin-right: auto; }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: clamp(1.1rem, 2vw, 2rem);
  }

  .site-header__nav a {
    position: relative;
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 560;
  }

  .site-header__nav a:hover,
  .site-header__nav a[aria-current='page'] { color: var(--ink); }

  .site-header__nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1.72rem;
    height: 2px;
    background: var(--accent);
  }

  .site-header__menu { display: none; }

  @media (max-width: 900px) {
    .site-header__nav,
    .site-header__contact { display: none; }

    .site-header__menu {
      display: block;
      position: relative;
    }

    .site-header__menu summary {
      width: 2.75rem;
      height: 2.75rem;
      display: grid;
      place-content: center;
      gap: 0.38rem;
      border: 1px solid var(--line);
      border-radius: 50%;
      cursor: pointer;
      list-style: none;
    }

    .site-header__menu summary::-webkit-details-marker { display: none; }
    .site-header__menu summary span {
      width: 1rem;
      height: 1px;
      background: var(--ink);
    }

    .site-header__menu nav {
      position: absolute;
      right: 0;
      top: calc(100% + 0.75rem);
      width: min(18rem, calc(100vw - 2rem));
      display: grid;
      padding: 0.55rem;
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      background: var(--white);
      box-shadow: var(--shadow-lg);
    }

    .site-header__menu nav a {
      padding: 0.85rem 0.9rem;
      border-radius: 0.7rem;
      color: var(--muted);
      font-size: 0.92rem;
      font-weight: 550;
    }

    .site-header__menu nav a:hover,
    .site-header__menu nav a[aria-current='page'] {
      color: var(--ink);
      background: var(--surface);
    }
  }
</style>
