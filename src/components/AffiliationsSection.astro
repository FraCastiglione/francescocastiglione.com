---
import type { CollectionEntry } from 'astro:content';

interface Props {
  affiliations: CollectionEntry<'affiliations'>[];
  projects: CollectionEntry<'projects'>[];
  news: CollectionEntry<'news'>[];
}

const { affiliations, projects, news } = Astro.props;
const projectLookup = new Map(projects.map((project) => [project.id, project]));
const publishedNews = news.filter((post) => !post.data.draft);
const getRelatedProjects = (ids: string[]) => ids.flatMap((id) => {
  const project = projectLookup.get(id);
  return project ? [project] : [];
});
const getRelatedNews = (affiliationId: string) => publishedNews
  .filter((post) => post.data.relatedAffiliations.includes(affiliationId))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<section class="affiliations" id="affiliations" aria-labelledby="affiliations-title">
  <div class="shell">
    <div class="affiliations__heading">
      <h2 id="affiliations-title">Affiliations</h2>
      <span>{affiliations.length} organisations, networks, and universities</span>
    </div>

    <div class="affiliations__grid">
      {affiliations.map((affiliation, index) => {
        const relatedProjects = getRelatedProjects(affiliation.data.relatedProjects);
        const relatedNews = getRelatedNews(affiliation.id);

        return (
          <article class="affiliation-card" data-affiliation={affiliation.id}>
            <div class:list={['affiliation-card__media', { 'affiliation-card__media--placeholder': !affiliation.data.image, 'affiliation-card__media--contain': affiliation.data.imageFit === 'contain' }]}>
              {affiliation.data.image
                ? <img src={affiliation.data.image} alt={affiliation.data.imageAlt ?? ''} loading="lazy" decoding="async" />
                : <span aria-hidden="true">{affiliation.data.monogram}</span>}
              <div class="affiliation-card__topline">
                <span>{String(index + 1).padStart(2, '0')}</span>
                {affiliation.data.active && <span class="affiliation-card__status">Current</span>}
              </div>
            </div>
            <div class="affiliation-card__content">
              <p class="affiliation-card__role">{affiliation.data.role}</p>
              <h3>{affiliation.data.name}</h3>
              <p class="affiliation-card__summary">{affiliation.data.summary}</p>
              <div class="affiliation-card__meta">
                <span>{affiliation.data.period}</span>
                <span>{affiliation.data.location}</span>
              </div>
              <div class="affiliation-card__links">
                <a href={affiliation.data.externalUrl} target="_blank" rel="noreferrer">Official website ↗</a>
                {relatedProjects.map((project) => <a href={`/projects/${project.id}/`}>Related project ↗</a>)}
                {relatedNews.slice(0, 2).map((post) => <a href={`/news/${post.id}/`}>{post.data.title} ↗</a>)}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .affiliations { padding: clamp(3rem, 6vw, 5rem) 0 clamp(4rem, 8vw, 7rem); border-top: 1px solid var(--line); background: linear-gradient(160deg, var(--blue-mist), var(--white) 68%); }
  .affiliations__heading { display: flex; justify-content: space-between; gap: 1.5rem; align-items: end; margin-bottom: clamp(1.4rem, 3vw, 2.2rem); }
  .affiliations__heading h2 { margin: 0; font-size: clamp(2.1rem, 4vw, 3.6rem); line-height: 1; letter-spacing: -.06em; }
  .affiliations__heading > span { color: var(--muted); font-size: .72rem; }
  .affiliations__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .affiliation-card { min-width: 0; overflow: hidden; display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: var(--radius-lg); background: rgba(255,255,255,.9); box-shadow: 0 1rem 3rem rgba(49,87,178,.05); }
  .affiliation-card__media { position: relative; min-height: 13rem; overflow: hidden; background: var(--surface-strong); }
  .affiliation-card__media img { width: 100%; height: 100%; min-height: 13rem; max-height: 17rem; object-fit: cover; }
  .affiliation-card__media--contain { display: grid; place-items: center; padding: clamp(1.7rem, 4vw, 3rem); background: var(--white); }
  .affiliation-card__media--contain img { min-height: 0; max-height: 8.5rem; object-fit: contain; }
  .affiliation-card[data-affiliation='eu-youth-stakeholders-group'] .affiliation-card__media img { object-position: center 22%; }
  .affiliation-card__media--placeholder { display: grid; place-items: center; color: var(--accent-dark); background: linear-gradient(145deg, var(--blue-mist), #c9d8f2); font-size: clamp(2.5rem, 6vw, 5rem); font-weight: 720; letter-spacing: -.06em; }
  .affiliation-card__topline { position: absolute; inset: .8rem .8rem auto; display: flex; justify-content: space-between; gap: 1rem; color: var(--ink); font-size: .58rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  .affiliation-card__topline > span { padding: .3rem .48rem; border-radius: 999px; background: rgba(255,255,255,.9); backdrop-filter: blur(8px); }
  .affiliation-card__status { color: var(--accent-dark); }
  .affiliation-card__content { flex: 1; display: flex; flex-direction: column; padding: 1.25rem; }
  .affiliation-card__role { margin: 0 0 .55rem; color: var(--accent-dark); font-size: .63rem; font-weight: 750; letter-spacing: .06em; text-transform: uppercase; }
  .affiliation-card h3 { margin: 0 0 .65rem; font-size: clamp(1.35rem, 2.6vw, 2rem); line-height: 1.04; letter-spacing: -.045em; }
  .affiliation-card__summary { margin: 0; color: var(--muted); font-size: .78rem; }
  .affiliation-card__meta { display: flex; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: 1.4rem; color: var(--muted); font-size: .62rem; }
  .affiliation-card__meta span:last-child { text-align: right; }
  .affiliation-card__links { display: flex; flex-wrap: wrap; gap: .6rem 1rem; margin-top: 1rem; padding-top: .9rem; border-top: 1px solid var(--line); }
  .affiliation-card__links a { max-width: 100%; color: var(--ink); font-size: .65rem; font-weight: 650; line-height: 1.35; }
  .affiliation-card__links a:hover { color: var(--accent-dark); }

  @media (max-width: 760px) {
    .affiliations__heading { align-items: flex-start; flex-direction: column; }
    .affiliations__grid { grid-template-columns: 1fr; }
    .affiliation-card__media, .affiliation-card__media img { min-height: 11rem; }
    .affiliation-card__meta { align-items: flex-start; flex-direction: column; }
    .affiliation-card__meta span:last-child { text-align: left; }
  }
</style>
